{
  "name": "dev-premium-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "vercel-build": "vite build --config vite.vercel.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:compatibility": "playwright test tests/compatibility.spec.ts",
    "test:seo": "playwright test tests/seo.spec.ts",
    "test:lighthouse": "lhci autorun",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "quality": "pnpm typecheck && pnpm vercel-build && pnpm check:bundle && pnpm test:responsive && pnpm test:compatibility && pnpm test:seo && pnpm test:lighthouse"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.55.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
